<Project>
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <BaseOutputPath>bin\</BaseOutputPath>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <BaseIntermediateOutputPath>obj\$(Platform)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Latest stable package versions checked on 2026-11-03. -->
    <LoggingAbstractionsVersion>10.0.14</LoggingAbstractionsVersion>
    <SuperSocketProtoBaseVersion>2.1.0</SuperSocketProtoBaseVersion>
    <SystemIOPortsVersion>10.0.14</SystemIOPortsVersion>
    <CoverletCollectorVersion>10.1.0</CoverletCollectorVersion>
    <MicrosoftNETTestSdkVersion>18.11.0</MicrosoftNETTestSdkVersion>
    <XunitVersion>2.9.3</XunitVersion>
    <XunitVisualStudioRunnerVersion>4.0.1</XunitVisualStudioRunnerVersion>
  </PropertyGroup>
</Project>
